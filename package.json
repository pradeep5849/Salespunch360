{
  "name": "salespunch360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "provision:initial-super-admin": "tsx scripts/provision-initial-super-admin.ts",
    "cleanup:checkins": "tsx scripts/cleanup-checkins.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prebuild": "prisma generate && (prisma migrate deploy || (echo \"Migration connection failed; retrying in 8s...\" && sleep 8 && prisma migrate deploy) || (echo \"Retry 2 failed; retrying in 8s...\" && sleep 8 && prisma migrate deploy) || (echo \"Retry 3 failed; retrying in 8s...\" && sleep 8 && prisma migrate deploy))"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.12.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.10.0",
    "next": "^16.3.3",
    "nodemailer": "^9.0.6",
    "prisma": "6.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
