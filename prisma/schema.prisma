generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  FIELD_ADMIN
  MANAGER
  SALES
  ACCOUNT_USER
}

/// Explicit Sales workspace identity. Kept independent from legacy Role during migration.
enum SalesRole {
  PRIMARY_ADMIN
  ADMIN
  MANAGER
  SALES
}

/// Explicit Account workspace identity. One fixed role per user.
enum AccountRole {
  ACCOUNT_ADMIN
  ACCOUNTANT
  PROJECT_MANAGER
  DATA_ENTRY
}

enum ManagerType {
  FIELD_MANAGER
  MANAGER_ONLY
}

enum ProductEdition {
  SALESPUNCH360
  SALESPUNCH360_ACCOUNT
  SALESPUNCH360_PLUS
}

/// Company-selected product capabilities. Account/Plus modules remain reserved
/// until their roadmap gates are released.
enum CompanyModule {
  SALES_CRM
  ATTENDANCE
  GPS_TRACKING
  FOLLOW_UP_TASKS
  TARGETS
  REPORTS
  INVENTORY
  ACCOUNTING
  PROJECTS
}

enum BranchAccessScope {
  ALL_BRANCHES
  SELECTED_BRANCHES
}

enum PushPlatform {
  ANDROID
}

enum TeamStructure {
  MANAGERS_AND_SALES
  SALES_ONLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum CheckoutSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum VisitType {
  NEW
  FOLLOW_UP
  CUSTOMER
}

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  MANUAL
  CUSTOMER_VISIT
  REFERRAL
  PHONE
  EMAIL
  WEBSITE
  OTHER
}

enum LeadActivityType {
  CREATED
  UPDATED
  ASSIGNED
  STAGE_CHANGED
  FOLLOW_UP_CHANGED
  WON
  LOST
  REOPENED
}

enum FollowUpTaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum GeofenceEventType {
  OUTSIDE_RADIUS
  INSUFFICIENT_ACCURACY
}

enum GeofenceAction {
  ATTENDANCE_START
  CUSTOMER_CHECK_IN
}

enum TargetMetric {
  LEADS_CREATED_COUNT
  WON_LEADS_COUNT
  WON_LEADS_VALUE
}

enum TargetPeriodType {
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum BillingPeriod {
  MONTHLY
  SIX_MONTH
  YEARLY
}

enum BillingRole {
  ADMIN
  MANAGER
  SALES
}

enum PaidSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum TravelApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}


enum CompensationStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum EmployeeFinancialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingAuditType {
  PRICING_CHANGED
  ORDER_CREATED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SEATS_CHANGED
  SUPER_ADMIN_OVERRIDE
  SUBSCRIPTION_SUSPENDED
}

model Company {
  id                                  String                   @id @default(uuid()) @db.Uuid
  name                                String
  slug                                String                   @unique
  teamStructure                       TeamStructure            @default(MANAGERS_AND_SALES)
  productEdition                      ProductEdition           @default(SALESPUNCH360)
  enabledModules                      CompanyModule[]          @default([SALES_CRM, ATTENDANCE, GPS_TRACKING, FOLLOW_UP_TASKS, TARGETS, REPORTS])
  trialStartedAt                      DateTime?
  trialEndsAt                         DateTime?
  subscriptionStatus                  SubscriptionStatus       @default(SUSPENDED)
  attendanceEnabled                   Boolean                  @default(true)
  gpsTrackingEnabled                  Boolean                  @default(false)
  checkoutRequiredBeforeNextCheckIn   Boolean                  @default(true)
  attendanceGeofenceEnabled           Boolean                  @default(false)
  attendanceReferenceLatitude         Float?
  attendanceReferenceLongitude        Float?
  attendanceGeofenceRadiusMeters      Int?
  customerCheckInGeofenceEnabled      Boolean                  @default(false)
  customerCheckInGeofenceRadiusMeters Int?
  travelRatePerKm                     Decimal?                 @db.Decimal(10, 2)
  createdAt                           DateTime                 @default(now())
  updatedAt                           DateTime                 @updatedAt
  addressLine1                        String?
  addressLine2                        String?
  locality                            String?
  city                                String?
  state                               String?
  postalCode                          String?
  country                             String?
  primaryContactName                  String?
  primaryPhone                        String?
  contactEmail                        String?
  alternatePhone                      String?
  website                             String?
  gstin                               String?
  pan                                 String?
  registrationNumber                  String?
  description                         String?
  logoObjectKey                       String?                  @db.VarChar(512)
  users                               User[]
  branches                            Branch[]
  attendances                         Attendance[]
  locationPoints                      LocationPoint[]
  customers                           Customer[]
  customerVisits                      CustomerVisit[]
  leads                               Lead[]
  leadActivities                      LeadActivity[]
  geofenceEvents                      GeofenceEvent[]
  salesTargets                        SalesTarget[]
  subscriptions                       CompanySubscription[]
  billingOrders                       BillingOrder[]
  payments                            PaymentTransaction[]
  billingAudits                       BillingAuditEvent[]
  visitPhotos                         VisitPhoto[]
  pendingStorageDeletions             PendingStorageDeletion[]
  leadDeletionAudits                  LeadDeletionAudit[]
  followUpTasks                       FollowUpTask[]
  pushDevices                         PushDevice[]
  dailyTravelApprovals                DailyTravelApproval[]

  @@index([subscriptionStatus, trialEndsAt])
  @@map("companies")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  companyId               String?                  @db.Uuid
  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name                    String
  email                   String                   @unique
  passwordHash            String
  sessionVersion          Int                      @default(0)
  role                    Role
  salesRole               SalesRole?
  accountRole             AccountRole?
  salesAccessActive       Boolean                  @default(false)
  accountAccessActive     Boolean                  @default(false)
  managerType             ManagerType?
  branchAccessScope       BranchAccessScope        @default(ALL_BRANCHES)
  phone                   String?
  employeeCode            String?
  designation             String?                  @db.VarChar(120)
  dateOfJoining           DateTime?                @db.Date
  travelAllowanceEnabled  Boolean                  @default(false)
  travelRatePerKm         Decimal?                 @db.Decimal(10, 2)
  isActive                Boolean                  @default(true)
  managerId               String?                  @db.Uuid
  manager                 User?                    @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reports                 User[]                   @relation("ManagerReports")
  sessions                Session[]
  branchAccesses          UserBranchAccess[]
  mobileSessions          MobileSession[]
  pushDevices             PushDevice[]
  attendances             Attendance[]
  locationPoints          LocationPoint[]
  customerVisits          CustomerVisit[]
  assignedCustomers       Customer[]               @relation("CustomerAssignee")
  uploadedVisitPhotos     VisitPhoto[]             @relation("VisitPhotoUploader")
  leadDeletionAudits      LeadDeletionAudit[]      @relation("LeadDeletionActor")
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  createdLeads            Lead[]                   @relation("LeadCreator")
  leadActivities          LeadActivity[]           @relation("LeadActor")
  previousLeadAssignments LeadActivity[]           @relation("PreviousLeadAssignee")
  newLeadAssignments      LeadActivity[]           @relation("NewLeadAssignee")
  geofenceEvents          GeofenceEvent[]          @relation("GeofenceEmployee")
  assignedTargets         SalesTarget[]            @relation("TargetAssignee")
  createdTargets          SalesTarget[]            @relation("TargetCreator")
  createdPrices           BillingPrice[]           @relation("PriceCreator")
  createdBillingOrders    BillingOrder[]           @relation("OrderCreator")
  billingAuditEvents      BillingAuditEvent[]      @relation("BillingAuditActor")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emailVerifiedAt         DateTime?
  emailVerificationTokens EmailVerificationToken[]
  assignedFollowUpTasks   FollowUpTask[]           @relation("FollowUpTaskAssignee")
  createdFollowUpTasks    FollowUpTask[]           @relation("FollowUpTaskCreator")
  dailyTravelApprovals    DailyTravelApproval[]    @relation("TravelApprovalEmployee")
  reviewedTravelApprovals DailyTravelApproval[]    @relation("TravelApprovalReviewer")

  @@unique([companyId, employeeCode])
  @@index([companyId, role])
  @@index([companyId, salesRole])
  @@index([companyId, accountRole])
  @@index([companyId, salesAccessActive, salesRole])
  @@index([companyId, accountAccessActive, accountRole])
  @@index([companyId, isActive, role])
  @@index([managerId])
  @@map("users")
}

model Branch {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name         String
  code         String
  isPrimary    Boolean            @default(false)
  isActive     Boolean            @default(true)
  addressLine1 String?
  addressLine2 String?
  locality     String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  email        String?
  gstin        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userAccesses UserBranchAccess[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
  @@map("branches")
}

model UserBranchAccess {
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_accesses")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Attendance {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId           String          @db.Uuid
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startedAt           DateTime        @default(now())
  endedAt             DateTime?
  startLatitude       Float?
  startLongitude      Float?
  startAccuracyMeters Float?
  endLatitude         Float?
  endLongitude        Float?
  endAccuracyMeters   Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  locationPoints      LocationPoint[]
  customerVisits      CustomerVisit[]
  geofenceEvents      GeofenceEvent[]

  @@index([companyId, startedAt])
  @@index([companyId, userId, startedAt])
  @@index([companyId, branchId])
  @@map("attendances")
}

model Customer {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId                 String          @db.Uuid
  company                   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUserId            String?         @db.Uuid
  assignedUser              User?           @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  name                      String
  contactPerson             String?
  phone                     String?
  email                     String?
  address                   String?
  latitude                  Float?
  longitude                 Float?
  checkInReferenceLatitude  Float?
  checkInReferenceLongitude Float?
  checkInReferenceVisitId   String?         @db.Uuid
  checkInReferenceSetAt     DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  visits                    CustomerVisit[]
  leads                     Lead[]
  geofenceEvents            GeofenceEvent[]

  @@index([companyId, name])
  @@index([companyId, createdAt])
  @@index([companyId, assignedUserId])
  @@index([companyId, branchId])
  @@map("customers")
}

model CustomerVisit {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId              String             @db.Uuid
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId                 String             @db.Uuid
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId             String?            @db.Uuid
  customer               Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId                 String?            @db.Uuid
  lead                   Lead?              @relation("VisitLead", fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visitType              VisitType          @default(CUSTOMER)
  contactName            String?            @db.VarChar(160)
  contactPhone           String?            @db.VarChar(30)
  attendanceId           String?            @db.Uuid
  attendance             Attendance?        @relation(fields: [attendanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInAt            DateTime           @default(now())
  checkInLatitude        Float
  checkInLongitude       Float
  checkInAccuracyMeters  Float
  checkInAddress         String?            @db.VarChar(1000)
  checkedOutAt           DateTime?
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracyMeters Float?
  checkoutSentiment      CheckoutSentiment?
  checkoutRemarks        String?
  visitNotes             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  sourceLeads            Lead[]             @relation("LeadSourceVisit")
  photo                  VisitPhoto?
  completedFollowUpTask  FollowUpTask?

  @@index([companyId, checkedInAt])
  @@index([companyId, userId, checkedInAt])
  @@index([companyId, customerId, checkedInAt])
  @@index([companyId, leadId, checkedInAt])
  @@index([companyId, userId, checkedOutAt])
  @@index([companyId, branchId])
  @@map("customer_visits")
}

model Lead {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId                 String          @db.Uuid
  company                   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId                String?         @db.Uuid
  customer                  Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceVisitId             String?         @db.Uuid
  sourceVisit               CustomerVisit?  @relation("LeadSourceVisit", fields: [sourceVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visits                    CustomerVisit[] @relation("VisitLead")
  checkInReferenceLatitude  Float?
  checkInReferenceLongitude Float?
  checkInReferenceVisitId   String?         @db.Uuid
  checkInReferenceSetAt     DateTime?
  assignedUserId            String          @db.Uuid
  assignedUser              User            @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId           String          @db.Uuid
  createdByUser             User            @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  title                     String          @db.VarChar(200)
  contactName               String?         @db.VarChar(150)
  phone                     String?         @db.VarChar(30)
  email                     String?         @db.VarChar(320)
  companyName               String?         @db.VarChar(200)
  source                    LeadSource      @default(MANUAL)
  stage                     LeadStage       @default(NEW)
  estimatedValue            Decimal?        @db.Decimal(18, 2)
  currencyCode              String          @default("INR") @db.Char(3)
  followUpAt                DateTime?
  notes                     String?         @db.VarChar(5000)
  lostReason                String?         @db.VarChar(1000)
  wonAt                     DateTime?
  lostAt                    DateTime?
  version                   Int             @default(1)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  activities                LeadActivity[]
  followUpTasks             FollowUpTask[]

  @@index([companyId, stage])
  @@index([companyId, assignedUserId])
  @@index([companyId, followUpAt])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([sourceVisitId])
  @@index([companyId, branchId])
  @@map("leads")
}

model FollowUpTask {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId        String             @db.Uuid
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId           String             @db.Uuid
  lead             Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUserId   String             @db.Uuid
  assignedUser     User               @relation("FollowUpTaskAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId  String             @db.Uuid
  createdByUser    User               @relation("FollowUpTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dueDate          DateTime           @db.Date
  notes            String?            @db.VarChar(2000)
  status           FollowUpTaskStatus @default(PENDING)
  completedVisitId String?            @unique @db.Uuid
  completedVisit   CustomerVisit?     @relation(fields: [completedVisitId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([companyId, assignedUserId, status, dueDate])
  @@index([companyId, leadId, status, dueDate])
  @@index([companyId, status, dueDate])
  @@index([companyId, branchId])
  @@map("follow_up_tasks")
}

model VisitPhoto {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @db.Uuid
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  visitId            String        @unique @db.Uuid
  visit              CustomerVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  uploadedByUserId   String        @db.Uuid
  uploadedByUser     User          @relation("VisitPhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  objectKey          String        @db.VarChar(500)
  thumbnailObjectKey String        @db.VarChar(500)
  mimeType           String        @db.VarChar(100)
  sizeBytes          Int
  thumbnailSizeBytes Int
  width              Int
  height             Int
  createdAt          DateTime      @default(now())

  @@index([companyId, createdAt])
  @@map("visit_photos")
}

model PendingStorageDeletion {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  objectKey     String    @unique @db.VarChar(500)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("pending_storage_deletions")
}

model LeadDeletionAudit {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUserId   String   @db.Uuid
  actorUser     User     @relation("LeadDeletionActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedLeadId String   @db.Uuid
  visitsDeleted Int
  photosQueued  Int
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("lead_deletion_audits")
}

model LeadActivity {
  id                     String           @id @default(uuid()) @db.Uuid
  companyId              String           @db.Uuid
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId                 String           @db.Uuid
  lead                   Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUserId            String           @db.Uuid
  actorUser              User             @relation("LeadActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type                   LeadActivityType
  fromStage              LeadStage?
  toStage                LeadStage?
  previousAssignedUserId String?          @db.Uuid
  previousAssignedUser   User?            @relation("PreviousLeadAssignee", fields: [previousAssignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  newAssignedUserId      String?          @db.Uuid
  newAssignedUser        User?            @relation("NewLeadAssignee", fields: [newAssignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt              DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([companyId, createdAt])
  @@map("lead_activities")
}

model LocationPoint {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId      String     @db.Uuid
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendanceId   String     @db.Uuid
  attendance     Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  capturedAt     DateTime
  receivedAt     DateTime   @default(now())
  sequenceNumber Int
  clientPointId  String?    @db.Uuid

  @@unique([attendanceId, sequenceNumber])
  @@unique([companyId, userId, clientPointId])
  @@index([companyId, userId, capturedAt])
  @@index([attendanceId, capturedAt])
  @@index([companyId, branchId])
  @@map("location_points")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash      String   @unique
  sessionVersion Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model MobileSession {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash      String       @unique @db.Char(64)
  sessionVersion Int          @default(0)
  expiresAt      DateTime
  lastUsedAt     DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  pushDevices    PushDevice[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("mobile_sessions")
}

model PushDevice {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  mobileSessionId String        @db.Uuid
  mobileSession   MobileSession @relation(fields: [mobileSessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  installationId  String        @unique @db.VarChar(128)
  fcmToken        String        @unique @db.VarChar(4096)
  platform        PushPlatform  @default(ANDROID)
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId, userId])
  @@index([mobileSessionId])
  @@map("push_devices")
}

model GeofenceEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId           String            @db.Uuid
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeId          String            @db.Uuid
  employee            User              @relation("GeofenceEmployee", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type                GeofenceEventType
  action              GeofenceAction
  customerId          String?           @db.Uuid
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendanceId        String?           @db.Uuid
  attendance          Attendance?       @relation(fields: [attendanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referenceLatitude   Float
  referenceLongitude  Float
  actualLatitude      Float
  actualLongitude     Float
  accuracyMeters      Float?
  allowedRadiusMeters Int
  distanceMeters      Float?
  occurredAt          DateTime          @default(now())

  @@index([companyId, occurredAt])
  @@index([companyId, employeeId, occurredAt])
  @@index([companyId, action, occurredAt])
  @@index([customerId, occurredAt])
  @@index([companyId, branchId])
  @@map("geofence_events")
}

model SalesTarget {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId       String           @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUserId  String           @db.Uuid
  assignedUser    User             @relation("TargetAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String           @db.Uuid
  createdByUser   User             @relation("TargetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metric          TargetMetric
  periodType      TargetPeriodType
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  targetValue     Decimal          @db.Decimal(18, 2)
  currencyCode    String           @default("INR") @db.Char(3)
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, assignedUserId, metric, startDate, endDate])
  @@index([companyId, assignedUserId])
  @@index([companyId, startDate, endDate])
  @@index([companyId, metric])
  @@index([companyId, branchId])
  @@map("sales_targets")
}

model DailyTravelApproval {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String?         @db.Uuid
  companyId        String               @db.Uuid
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  employeeId       String               @db.Uuid
  employee         User                 @relation("TravelApprovalEmployee", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessDate     DateTime             @db.Date
  distanceMeters   Int
  ratePerKm        Decimal              @db.Decimal(10, 2)
  amount           Decimal              @db.Decimal(18, 2)
  status           TravelApprovalStatus @default(PENDING)
  reviewedByUserId String?              @db.Uuid
  reviewedBy       User?                @relation("TravelApprovalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([companyId, employeeId, businessDate])
  @@index([companyId, businessDate, status])
  @@index([employeeId, businessDate])
  @@index([companyId, branchId])
  @@map("daily_travel_approvals")
}

model EmployeeCompensationProfile {
