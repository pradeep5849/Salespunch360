generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  FIELD_ADMIN
  MANAGER
  SALES
  ACCOUNT_USER
}

/// Explicit Sales workspace identity. Kept independent from legacy Role during migration.
enum SalesRole {
  PRIMARY_ADMIN
  ADMIN
  MANAGER
  SALES
}

/// Explicit Account workspace identity. One fixed role per user.
enum AccountRole {
  ACCOUNT_ADMIN
  ACCOUNTANT
  PROJECT_MANAGER
  DATA_ENTRY
}

enum ManagerType {
  FIELD_MANAGER
  MANAGER_ONLY
}

