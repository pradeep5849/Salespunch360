generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  SALES
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum CheckoutSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum LeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}
enum LeadSource {
  MANUAL
  CUSTOMER_VISIT
  REFERRAL
  PHONE
  EMAIL
  WEBSITE
  OTHER
}
enum LeadActivityType {
  CREATED
  UPDATED
  ASSIGNED
  STAGE_CHANGED
  FOLLOW_UP_CHANGED
  WON
  LOST
  REOPENED
}

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String             @unique
  trialStartedAt     DateTime?
  trialEndsAt        DateTime?
  subscriptionStatus SubscriptionStatus @default(SUSPENDED)
  attendanceEnabled  Boolean            @default(true)
  gpsTrackingEnabled Boolean            @default(false)
  checkoutRequiredBeforeNextCheckIn Boolean @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              User[]
  attendances        Attendance[]
  locationPoints     LocationPoint[]
  customers          Customer[]
  customerVisits     CustomerVisit[]
  leads              Lead[]
  leadActivities     LeadActivity[]

  @@index([subscriptionStatus, trialEndsAt])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String?   @db.Uuid
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  phone        String?
  employeeCode String?
  isActive     Boolean   @default(true)
  managerId    String?   @db.Uuid
  manager      User?     @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reports      User[]    @relation("ManagerReports")
  sessions     Session[]
  attendances  Attendance[]
  locationPoints LocationPoint[]
  customerVisits CustomerVisit[]
  assignedLeads Lead[] @relation("LeadAssignee")
  createdLeads Lead[] @relation("LeadCreator")
  leadActivities LeadActivity[] @relation("LeadActor")
  previousLeadAssignments LeadActivity[] @relation("PreviousLeadAssignee")
  newLeadAssignments LeadActivity[] @relation("NewLeadAssignee")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, role])
  @@index([companyId, isActive, role])
  @@index([managerId])
  @@unique([companyId, employeeCode])
  @@map("users")
}

model Attendance {
  id                  String          @id @default(uuid()) @db.Uuid
  companyId           String          @db.Uuid
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startedAt           DateTime        @default(now())
  endedAt             DateTime?
  startLatitude       Float?
  startLongitude      Float?
  startAccuracyMeters Float?
  endLatitude         Float?
  endLongitude        Float?
  endAccuracyMeters   Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  locationPoints      LocationPoint[]
  customerVisits      CustomerVisit[]

  @@index([companyId, startedAt])
  @@index([companyId, userId, startedAt])
  @@map("attendances")
}

model Customer {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  visits        CustomerVisit[]
  leads         Lead[]

  @@index([companyId, name])
  @@index([companyId, createdAt])
  @@map("customers")
}

model CustomerVisit {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @db.Uuid
  company               Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId                String             @db.Uuid
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId            String             @db.Uuid
  customer              Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendanceId          String?            @db.Uuid
  attendance            Attendance?        @relation(fields: [attendanceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkedInAt           DateTime           @default(now())
  checkInLatitude       Float
  checkInLongitude      Float
  checkInAccuracyMeters Float
  checkedOutAt          DateTime?
  checkOutLatitude      Float?
  checkOutLongitude     Float?
  checkOutAccuracyMeters Float?
  checkoutSentiment     CheckoutSentiment?
  checkoutRemarks       String?
  visitNotes            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  leads                 Lead[]

  @@index([companyId, checkedInAt])
  @@index([companyId, userId, checkedInAt])
  @@index([companyId, customerId, checkedInAt])
  @@index([companyId, userId, checkedOutAt])
  @@map("customer_visits")
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceVisitId String? @db.Uuid
  sourceVisit CustomerVisit? @relation(fields: [sourceVisitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUserId String @db.Uuid
  assignedUser User @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdByUserId String @db.Uuid
  createdByUser User @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  title String @db.VarChar(200)
  contactName String? @db.VarChar(150)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(320)
  companyName String? @db.VarChar(200)
  source LeadSource @default(MANUAL)
  stage LeadStage @default(NEW)
  estimatedValue Decimal? @db.Decimal(18, 2)
  currencyCode String @default("INR") @db.Char(3)
  followUpAt DateTime?
  notes String? @db.VarChar(5000)
  lostReason String? @db.VarChar(1000)
  wonAt DateTime?
  lostAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities LeadActivity[]
  @@index([companyId, stage])
  @@index([companyId, assignedUserId])
  @@index([companyId, followUpAt])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([sourceVisitId])
  @@map("leads")
}

model LeadActivity {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId String @db.Uuid
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorUserId String @db.Uuid
  actorUser User @relation("LeadActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type LeadActivityType
  fromStage LeadStage?
  toStage LeadStage?
  previousAssignedUserId String? @db.Uuid
  previousAssignedUser User? @relation("PreviousLeadAssignee", fields: [previousAssignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  newAssignedUserId String? @db.Uuid
  newAssignedUser User? @relation("NewLeadAssignee", fields: [newAssignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
  @@index([companyId, createdAt])
  @@map("lead_activities")
}

model LocationPoint {
  id             String     @id @default(uuid()) @db.Uuid
  companyId      String     @db.Uuid
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attendanceId   String     @db.Uuid
  attendance     Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  latitude       Float
  longitude      Float
  accuracyMeters Float?
  capturedAt     DateTime
  receivedAt     DateTime   @default(now())
  sequenceNumber Int

  @@unique([attendanceId, sequenceNumber])
  @@index([companyId, userId, capturedAt])
  @@index([attendanceId, capturedAt])
  @@map("location_points")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
