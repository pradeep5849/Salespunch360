model EmployeeAdvance {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  branchId String @db.Uuid
  employeeId String @db.Uuid
  amount Decimal @db.Decimal(18, 2)
  currencyCode String @default("INR") @db.Char(3)
  advanceDate DateTime @db.Date
  note String? @db.VarChar(1000)
  reference String? @db.VarChar(120)
  status EmployeeFinancialRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, branchId, employeeId])
  @@map("employee_advances")
}

model EmployeeReimbursement {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  branchId String @db.Uuid
  employeeId String @db.Uuid
  amount Decimal @db.Decimal(18, 2)
  currencyCode String @default("INR") @db.Char(3)
