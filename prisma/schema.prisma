  companyId String @db.Uuid
  employeeId String @db.Uuid
  compensationProfileId String @db.Uuid
  payrollReference String? @db.VarChar(120)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  createdAt DateTime @default(now())
  @@unique([companyId, employeeId, periodStart, periodEnd])
  @@index([compensationProfileId])
  @@map("salary_history_links")
}

model BillingPrice {
  id              String        @id @default(uuid()) @db.Uuid
  role            BillingRole
  period          BillingPeriod
  amount          Decimal       @db.Decimal(18, 2)
  currency        String        @default("INR") @db.Char(3)
  effectiveFrom   DateTime      @default(now())
  effectiveUntil  DateTime?
  createdByUserId String?       @db.Uuid
  createdByUser   User?         @relation("PriceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@index([role, period, effectiveFrom])
  @@map("billing_prices")
}

model CompanySubscription {
  id            String                 @id @default(uuid()) @db.Uuid
  companyId     String                 @db.Uuid
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status        PaidSubscriptionStatus
  billingPeriod BillingPeriod
  adminSeats    Int                    @default(0)
  managerSeats  Int
  salesSeats    Int
  startsAt      DateTime
  endsAt        DateTime
  sourceOrderId String?                @unique @db.Uuid
  sourceOrder   BillingOrder?          @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([companyId, status, endsAt])
  @@map("company_subscriptions")
}

model BillingOrder {
  id                     String               @id @default(uuid()) @db.Uuid
  companyId              String               @db.Uuid
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdByUserId        String               @db.Uuid
  createdByUser          User                 @relation("OrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  billingPeriod          BillingPeriod
  adminSeats             Int                  @default(0)
  managerSeats           Int
  salesSeats             Int
  adminUnitPrice         Decimal              @default(0) @db.Decimal(18, 2)
  managerUnitPrice       Decimal              @db.Decimal(18, 2)
  salesUnitPrice         Decimal              @db.Decimal(18, 2)
  currency               String               @db.Char(3)
  subtotal               Decimal              @db.Decimal(18, 2)
  taxAmount              Decimal              @default(0) @db.Decimal(18, 2)
  totalAmount            Decimal              @db.Decimal(18, 2)
  status                 BillingOrderStatus   @default(PENDING)
  provider               String               @default("UNCONFIGURED") @db.VarChar(40)
  providerOrderId        String?              @unique @db.VarChar(200)
  idempotencyKey         String               @unique @db.VarChar(100)
  retainAdminUserIds     String[]             @default([]) @db.Uuid
  retainManagerUserIds   String[]             @default([]) @db.Uuid
  retainSalesUserIds     String[]             @default([]) @db.Uuid
  seatReductionAppliedAt DateTime?
  paidAt                 DateTime?
  expiresAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  payments               PaymentTransaction[]
  subscription           CompanySubscription?

  @@index([companyId, createdAt])
  @@map("billing_orders")
}

model PaymentTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderId           String        @db.Uuid
  order             BillingOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String        @db.VarChar(40)
  providerPaymentId String        @unique @db.VarChar(200)
  amount            Decimal       @db.Decimal(18, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus
  capturedAt        DateTime?
  failureCode       String?       @db.VarChar(100)
  failureMessage    String?       @db.VarChar(500)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId, createdAt])
  @@index([orderId])
  @@map("payment_transactions")
}

model BillingAuditEvent {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUserId String?          @db.Uuid
  actorUser   User?            @relation("BillingAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  type        BillingAuditType
  entityId    String?          @db.Uuid
  reason      String?          @db.VarChar(500)
  metadata    Json?
  occurredAt  DateTime         @default(now())

  @@index([companyId, occurredAt])
  @@index([type, occurredAt])
  @@map("billing_audit_events")
}

model RateLimitBucket {
  key       String   @id @db.VarChar(128)
  count     Int
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  @@index([resetsAt])
  @@map("rate_limit_buckets")
}
