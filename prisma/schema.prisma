model Company {
  id                                  String                     @id @default(uuid()) @db.Uuid
  name                                String
  slug                                String                     @unique
  teamStructure                       TeamStructure              @default(MANAGERS_AND_SALES)
  productEdition                      ProductEdition             @default(SALESPUNCH360)
  enabledModules                      CompanyModule[]            @default([SALES_CRM, ATTENDANCE, GPS_TRACKING, FOLLOW_UP_TASKS, TARGETS, REPORTS])
  trialStartedAt                      DateTime?
  trialEndsAt                         DateTime?
  subscriptionStatus                  SubscriptionStatus         @default(SUSPENDED)
  attendanceEnabled                   Boolean                    @default(true)
  gpsTrackingEnabled                  Boolean                    @default(false)
  checkoutRequiredBeforeNextCheckIn   Boolean                    @default(true)
  attendanceGeofenceEnabled           Boolean                    @default(false)
  attendanceReferenceLatitude         Float?
  attendanceReferenceLongitude        Float?
  attendanceGeofenceRadiusMeters      Int?
  customerCheckInGeofenceEnabled      Boolean                    @default(false)
  customerCheckInGeofenceRadiusMeters Int?
  travelRatePerKm                     Decimal?                   @db.Decimal(10, 2)
  createdAt                           DateTime                   @default(now())
  updatedAt                           DateTime                   @updatedAt
  addressLine1                        String?
  addressLine2                        String?
  locality                            String?
  city                                String?
  state                               String?
  postalCode                          String?
  country                             String?
  primaryContactName                  String?
  primaryPhone                        String?
  contactEmail                        String?
  alternatePhone                      String?
  website                             String?
  gstin                               String?
  pan                                 String?
  registrationNumber                  String?
  description                         String?
  logoObjectKey                       String?                    @db.VarChar(512)
  accountSettings                     AccountSettings?
  financialYears                      FinancialYear[]
  numberingSeries                     NumberingSeries[]
  accountUnits                        AccountUnit[]
  accountCategories                   AccountCategory[]
  accountProducts                     AccountProduct[]
  accountServices                     AccountService[]
  vendors                             Vendor[]
  workCategories                      WorkCategory[]
  workPackages                        WorkPackage[]
  customFieldDefinitions              CustomFieldDefinition[]
  ledgerAccounts                      LedgerAccount[]
  journalEntries                      JournalEntry[]
  journalLines                        JournalLine[]
  costCentres                         CostCentre[]
  accountingPeriodLocks               AccountingPeriodLock[]
  accountingAuditEvents               AccountingAuditEvent[]
  accountImportJobs                    AccountImportJob[]
  recycleBinRecords                    AccountRecycleRecord[]
  customFieldValues                    CustomFieldValue[]
  printTemplates                       PrintTemplate[]
  termsTemplates                       AccountTermsTemplate[]
  backupRecords                        AccountBackupRecord[]
  users                               User[]
  branches                            Branch[]
  attendances                         Attendance[]
  locationPoints                      LocationPoint[]
  customers                           Customer[]
  customerVisits                      CustomerVisit[]
  leads                               Lead[]
  leadActivities                      LeadActivity[]
  geofenceEvents                      GeofenceEvent[]
  salesTargets                        SalesTarget[]
  subscriptions                       CompanySubscription[]
  billingOrders                       BillingOrder[]
  payments                            PaymentTransaction[]
  billingAudits                       BillingAuditEvent[]
  visitPhotos                         VisitPhoto[]
  pendingStorageDeletions             PendingStorageDeletion[]
  leadDeletionAudits                  LeadDeletionAudit[]
  followUpTasks                       FollowUpTask[]
  pushDevices                         PushDevice[]
  dailyTravelApprovals                DailyTravelApproval[]
  quotationDocuments                  QuotationDocument[]
  quotationRevisions                  QuotationRevision[]
  quotationLines                      QuotationLine[]
  quotationAdjustments                QuotationAdjustment[]
  quotationPaymentSchedules           QuotationPaymentSchedule[]
  quotationShares                     QuotationShare[]
  quotationAuditEvents                QuotationAuditEvent[]
  commercialDocuments                 CommercialDocument[]
  settlements                         AccountSettlement[]
  paymentReminders                    PaymentReminder[]
  commercialAudits                    CommercialAuditEvent[]
  settlementAllocations               SettlementAllocation[]
  partyOpeningBalances                PartyOpeningBalance[]
  authorizedSignatureVersions          AuthorizedSignatureVersion[]
  advanceApplications                 AdvanceApplication[]
  projects                            Project[]
  projectMembers                      ProjectMember[]
  projectBudgetLines                  ProjectBudgetLine[]
  projectMilestones                   ProjectMilestone[]
  projectTasks                        ProjectTask[]
  projectDocuments                    ProjectDocument[]
  projectAuditEvents                  ProjectAuditEvent[]

  @@index([subscriptionStatus, trialEndsAt])
  @@map("companies")
}

model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  companyId                  String?                  @db.Uuid
  company                    Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name                       String
  email                      String                   @unique
  passwordHash               String
  sessionVersion             Int                      @default(0)
  role                       Role
  salesRole                  SalesRole?
  accountRole                AccountRole?
  salesAccessActive          Boolean                  @default(false)
  accountAccessActive        Boolean                  @default(false)
  managerType                ManagerType?
  branchAccessScope          BranchAccessScope        @default(ALL_BRANCHES)
  phone                      String?
  employeeCode               String?
  designation                String?                  @db.VarChar(120)
  dateOfJoining              DateTime?                @db.Date
  travelAllowanceEnabled     Boolean                  @default(false)
  travelRatePerKm            Decimal?                 @db.Decimal(10, 2)
  isActive                   Boolean                  @default(true)
  managerId                  String?                  @db.Uuid
  manager                    User?                    @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  reports                    User[]                   @relation("ManagerReports")
  sessions                   Session[]
  branchAccesses             UserBranchAccess[]
  mobileSessions             MobileSession[]
  pushDevices                PushDevice[]
  attendances                Attendance[]
  locationPoints             LocationPoint[]
  customerVisits             CustomerVisit[]
  assignedCustomers          Customer[]               @relation("CustomerAssignee")
  uploadedVisitPhotos        VisitPhoto[]             @relation("VisitPhotoUploader")
  leadDeletionAudits         LeadDeletionAudit[]      @relation("LeadDeletionActor")
  assignedLeads              Lead[]                   @relation("LeadAssignee")
  createdLeads               Lead[]                   @relation("LeadCreator")
  leadActivities             LeadActivity[]           @relation("LeadActor")
  previousLeadAssignments    LeadActivity[]           @relation("PreviousLeadAssignee")
  newLeadAssignments         LeadActivity[]           @relation("NewLeadAssignee")
  geofenceEvents             GeofenceEvent[]          @relation("GeofenceEmployee")
  assignedTargets            SalesTarget[]            @relation("TargetAssignee")
  createdTargets             SalesTarget[]            @relation("TargetCreator")
  createdPrices              BillingPrice[]           @relation("PriceCreator")
  createdBillingOrders       BillingOrder[]           @relation("OrderCreator")
  billingAuditEvents         BillingAuditEvent[]      @relation("BillingAuditActor")
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  emailVerifiedAt            DateTime?
  emailVerificationTokens    EmailVerificationToken[]
  assignedFollowUpTasks      FollowUpTask[]           @relation("FollowUpTaskAssignee")
  createdFollowUpTasks       FollowUpTask[]           @relation("FollowUpTaskCreator")
  dailyTravelApprovals       DailyTravelApproval[]    @relation("TravelApprovalEmployee")
  reviewedTravelApprovals    DailyTravelApproval[]    @relation("TravelApprovalReviewer")
  createdJournalEntries      JournalEntry[]           @relation("JournalCreator")
  postedJournalEntries       JournalEntry[]           @relation("JournalPoster")
  accountingAuditEvents      AccountingAuditEvent[]   @relation("AccountingAuditActor")
  updatedAccountingLocks     AccountingPeriodLock[]   @relation("AccountingLockUpdater")
  createdQuotationDocuments  QuotationDocument[]      @relation("QuotationCreator")
  acceptedQuotationDocuments QuotationDocument[]      @relation("QuotationAcceptor")
  quotationAuditEvents       QuotationAuditEvent[]    @relation("QuotationAuditActor")
  commercialDocuments        CommercialDocument[]     @relation("CommercialDocumentCreator")
  settlements                AccountSettlement[]      @relation("SettlementCreator")
  commercialAudits           CommercialAuditEvent[]   @relation("CommercialAuditActor")
  paymentReminders           PaymentReminder[]        @relation("PaymentReminderActor")
  advanceApplications        AdvanceApplication[]     @relation("AdvanceApplicationActor")
  createdPartyOpeningBalances PartyOpeningBalance[]    @relation("PartyOpeningBalanceCreator")
  uploadedSignatureVersions   AuthorizedSignatureVersion[] @relation("AuthorizedSignatureUploader")
  managedProjects            Project[]                @relation("ProjectManager")
  createdProjects            Project[]                @relation("ProjectCreator")
  closedProjects             Project[]                @relation("ProjectCloser")
  projectMemberships         ProjectMember[]
  assignedProjectTasks       ProjectTask[]            @relation("ProjectTaskAssignee")
  createdProjectTasks        ProjectTask[]            @relation("ProjectTaskCreator")
  createdProjectMilestones   ProjectMilestone[]
  uploadedProjectDocuments   ProjectDocument[]
  projectAuditEvents         ProjectAuditEvent[]

  @@unique([companyId, id])
  @@unique([companyId, employeeCode])
  @@index([companyId, role])
  @@index([companyId, salesRole])
  @@index([companyId, accountRole])
  @@index([companyId, salesAccessActive, salesRole])
  @@index([companyId, accountAccessActive, accountRole])
  @@index([companyId, isActive, role])
  @@index([managerId])
  @@map("users")
}

model Branch {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @db.Uuid
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name                String
  code                String
  isPrimary           Boolean              @default(false)
  isActive            Boolean              @default(true)
  addressLine1        String?
  addressLine2        String?
  locality            String?
  city                String?
  state               String?
  postalCode          String?
  country             String?
  phone               String?
  email               String?
  gstin               String?
  gstStateCode        String?                @db.VarChar(2)
  gstRegistrationType GstRegistrationType    @default(UNREGISTERED)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userAccesses        UserBranchAccess[]
  numberingSeries     NumberingSeries[]
  journalEntries      JournalEntry[]
  quotationDocuments  QuotationDocument[]
  commercialDocuments CommercialDocument[]
  settlements         AccountSettlement[]
  partyOpeningBalances PartyOpeningBalance[]
  projects            Project[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
  @@map("branches")
}

model UserBranchAccess {
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branch_accesses")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Attendance {
  id                  String          @id @default(uuid()) @db.Uuid
  branchId            String          @db.Uuid
  companyId           String          @db.Uuid
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userId              String          @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startedAt           DateTime        @default(now())
  endedAt             DateTime?
  startLatitude       Float?
  startLongitude      Float?
  startAccuracyMeters Float?
  endLatitude         Float?
  endLongitude        Float?
  endAccuracyMeters   Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  locationPoints      LocationPoint[]
  customerVisits      CustomerVisit[]
  geofenceEvents      GeofenceEvent[]

  @@index([companyId, startedAt])
  @@index([companyId, userId, startedAt])
  @@index([companyId, branchId, userId, startedAt])
  @@index([companyId, branchId])
  @@map("attendances")
}

model Customer {
  id                        String               @id @default(uuid()) @db.Uuid
  branchId                  String               @db.Uuid
  companyId                 String               @db.Uuid
  company                   Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUserId            String?              @db.Uuid
  assignedUser              User?                @relation("CustomerAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  name                      String
  contactPerson             String?
  phone                     String?
  email                     String?
  address                   String?
  latitude                  Float?
  longitude                 Float?
  checkInReferenceLatitude  Float?
  checkInReferenceLongitude Float?
  checkInReferenceVisitId   String?              @db.Uuid
  checkInReferenceSetAt     DateTime?
  billingAddress            String?
  shippingAddress           String?
  gstin                     String?              @db.VarChar(15)
  stateCode                 String?              @db.VarChar(2)
  gstRegistrationType       GstRegistrationType  @default(UNREGISTERED)
  pan                       String?              @db.VarChar(10)
  notes                     String?
  isActive                  Boolean              @default(true)
  isAccountCustomer         Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  visits                    CustomerVisit[]
  leads                     Lead[]
  geofenceEvents            GeofenceEvent[]
  quotationDocuments        QuotationDocument[]
  projects                  Project[]
  commercialDocuments       CommercialDocument[] @relation("CommercialCustomer")
  settlements               AccountSettlement[]  @relation("SettlementCustomer")
  paymentReminders          PaymentReminder[]    @relation("PaymentReminderCustomer")

  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, createdAt])
  @@index([companyId, assignedUserId])
  @@index([companyId, branchId])
  @@map("customers")
}

model CustomerVisit {
  id                     String             @id @default(uuid()) @db.Uuid
  branchId               String             @db.Uuid
  companyId              String             @db.Uuid
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
