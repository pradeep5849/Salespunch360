# Safe placeholders only. Generate a unique secret; never reuse this text.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
AUTH_SECRET="generate-a-unique-random-secret-of-at-least-48-characters"
NODE_ENV="development"
APP_URL="https://www.salespunch360.com"
TRUST_PROXY="false"
PAYMENT_PROVIDER="UNCONFIGURED"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@salespunch360.com"
SMTP_PASSWORD="replace-with-the-hostinger-mailbox-password"
MAIL_FROM="noreply@salespunch360.com"
# Public browser key restricted to the deployed web origins and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
STORAGE_DRIVER=hostinger
HOSTINGER_STORAGE_PATH=
# Optional conservative travel-distance quality limits (defaults shown).
TRAVEL_MAX_ACCURACY_METERS="100"
TRAVEL_MAX_SPEED_METERS_PER_SECOND="55"
TRAVEL_MAX_GAP_MINUTES="30"
TRAVEL_MIN_MOVEMENT_METERS="5"
TRAVEL_ACCURACY_UNCERTAINTY_FACTOR="0.5"
